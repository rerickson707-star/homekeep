{
  "framework": "vite",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/warranty-tracker", "destination": "/warranty-tracker.html" },
    { "source": "/ada", "destination": "/ada.html" },
    { "source": "/guides", "destination": "/index.html" },
    { "source": "/unsubscribe", "destination": "/index.html" },
    { "source": "/recall-alerts", "destination": "/index.html" },
    { "source": "/ai-scan", "destination": "/index.html" },
    { "source": "/email-capture", "destination": "/index.html" },
    { "source": "/home-maintenance-tracker", "destination": "/index.html" },
    { "source": "/contractor-tracker", "destination": "/index.html" },
    { "source": "/home-insurance-tracker", "destination": "/index.html" },
    { "source": "/home-expense-tracker", "destination": "/index.html" },
    { "source": "/home-projects", "destination": "/index.html" },
    { "source": "/home-document-vault", "destination": "/index.html" },
    { "source": "/affiliates", "destination": "/index.html" },
    { "source": "/affiliate-agreement", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
